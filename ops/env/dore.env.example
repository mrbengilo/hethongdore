# Runtime configuration for the single DORE Node.js process.
# Install as /etc/dore/dore.env with mode 0600. Do not commit the real file.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
TZ=Asia/Ho_Chi_Minh
DORE_DB_PLATFORM=sqlite
DORE_DATABASE_PATH=/var/lib/dore/dore.sqlite
DORE_UPLOAD_DIR=/var/lib/dore/uploads

# Generate this value on the server with:
#   sudo /usr/local/lib/dore/set-manager-password.mjs --username admin
# Never put a plaintext password here.
DORE_MANAGER_PASSWORD_HASH=SET_WITH_PASSWORD_TOOL
