    "test:auth-ops": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/auth-cookie-security.test.mjs",
    "test:shift-order-atomicity": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/shift-order-atomicity.test.mjs",
    "test:store-orders-management": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/store-orders-management.test.mjs tests/employee-orders-readonly-ui.test.mjs",
    "test:super-admin-reset": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/super-admin-reset.test.mjs tests/super-admin-employees-ui.test.mjs tests/super-admin-employee-directory.test.mjs",
