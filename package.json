    "test:attendance-location": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/attendance-location.test.mjs",
    "test:order-code-sequence": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/order-code-sequence.test.mjs",
    "test:notification-read-lifecycle": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/notification-read-lifecycle.test.mjs",
    "test:employee-attendance-stats": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/employee-attendance-stats.test.mjs",
    "test:employee-lifecycle": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/employee-lifecycle.test.mjs tests/employee-lifecycle-period.test.mjs tests/employee-lifecycle-compatibility.test.mjs",
