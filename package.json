    "test:manager-store-scope": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/manager-store-scope.test.mjs",
    "test:store-deletion": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/store-deletion.test.mjs",
    "test:store-overview-finance": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/store-overview-finance.test.mjs",
    "test:daily-shifts": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/daily-shifts.test.mjs",
    "test:salary-advances": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/salary-advances.test.mjs",
    "test:attendance-policy": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/attendance-policy.test.mjs",
    "test:payroll-policy": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/payroll-policy.test.mjs",
    "test:attendance-stats": "node --require ./tests/tsx-windows-userinfo.cjs --import tsx --test tests/attendance-stats.test.mjs",
